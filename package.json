{
  "name": "stoop",
  "version": "0.1.0",
  "private": true,
  "description": "Stoop: an AI media planner for NYC street screens, grounded in Qloo taste data.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "geo:build": "tsx scripts/build-geo.ts",
    "fixtures:gen": "tsx scripts/gen-fixtures.ts",
    "qloo:smoke": "tsx scripts/qloo-smoke.ts",
    "audit:public": "tsx scripts/audit-public.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/groq": "4.0.70",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@ai-sdk/react": "4.0.157",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/functions": "3.10.3",
    "ai": "7.0.153",
    "jsonrepair": "3.15.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "nanoid": "6.0.2",
    "next": "16.4.3",
    "ngeohash": "0.6.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@turf/area": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@types/ngeohash": "0.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "mapshaper": "0.7.98",
    "simple-statistics": "7.12.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
