# Copy to .env.local for local development. Placeholders only — never commit real values.
# Without any keys the app runs fully in SYNTHETIC mock mode.

# Qloo (hackathon key; server-side only)
QLOO_MODE=mock                      # mock | live | cache-only | off
QLOO_API_KEY=replace-with-your-event-credential
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Language models (free tiers; no payment method attached)
LLM_MODE=mock                       # mock | live
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
# Gemini is only offered to visitors from these countries (never EEA, CH or UK). Default:
# GEMINI_ALLOWED_COUNTRIES=US,CA,TR,MX,BR,AU,NZ,JP,KR,IN,SG,ZA,AE

# Redis (Upstash via the Vercel Marketplace injects these in deployments)
REDIS_PREFIX=d:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App secrets (generate long random values per environment)
SESSION_SECRET=
ADMIN_TOKEN=
SHARING_ENABLED=false
